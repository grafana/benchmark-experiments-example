ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Grafana's Hosted MCP Server URL, with your stack's host in the path.
# Authenticate with `go run ./cmd/watcherbench login` (OAuth); the hosted
# server does not accept service account tokens.
MCP_URL=https://mcp.grafana.com/mcp/<your-stack>.grafana.net

# Grafana Cloud instance's service account token - gcx's setup-gcx skill asks for a service account token
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...


# Agent Observability (generation ingest) - from the Connection tab of the
# Agent Observability plugin in your Grafana Cloud stack.
AGENTO11Y_ENDPOINT=https://agento11y-<region>.grafana.net
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=glc_...
AGENTO11Y_CONTENT_CAPTURE_MODE=full

# Benchmark experiment publishing. The control plane uses the Grafana service
# account above; experiment ingest uses AGENTO11Y_AUTH_TOKEN.
# Leave AGENTO11Y_GRAFANA_URL blank to derive it from a stack-in-path MCP_URL,
# or set it to your stack, for example https://mystack.grafana.net.
AGENTO11Y_GRAFANA_URL=
AGENTO11Y_INGEST_ACTOR=ingest:watcherbench/o11y-bench
AGENTO11Y_SUITE_ID=watcherbench-o11y-bench
# Suite version to pin when comparing candidates (for example v1). Blank means
# latest_published, resolved to a concrete version when a run starts. To pin
# one run, pass EXPERIMENT_SUITE_VERSION=v1 to make instead: values in this
# file override shell variables under op run --env-file.
AGENTO11Y_SUITE_VERSION=
# Trials per task; default to 3 for demonstration purposes.
EXPERIMENT_TRIALS=3

# OTel traces/metrics (separate channel, same token) - from the stack's
# OpenTelemetry integration tile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
